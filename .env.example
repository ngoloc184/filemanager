NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Secret key for POST /api/superapp/files (generate: openssl rand -hex 32)
SUPERAPP_API_KEY=your-superapp-api-key-here

# --- Web Push for chat messages (optional; generate: npm run push:keys) ---
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# --- AI assistant (optional language model for summaries; off by default) ---
# ASSISTANT_LLM_BASE_URL=http://localhost:11434/v1
# ASSISTANT_LLM_MODEL=qwen2.5:7b-instruct
# ASSISTANT_LLM_API_KEY=
# ASSISTANT_LLM_ALLOW_FILE_CONTENT=false
# ASSISTANT_MAX_INDEX_MB=15
